{
  "name": "xpreiIDE-ai",
  "displayName": "xpreiIDE AI",
  "description": "Bring-your-own-model AI assistant. Chat with local Ollama or any OpenAI-compatible endpoint.",
  "version": "0.0.1",
  "publisher": "xpreiIDE",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Machine Learning",
    "Chat",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "xpreiIDE",
          "title": "xpreiIDE",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "xpreiIDE": [
        {
          "type": "webview",
          "id": "xpreiIDE.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "xpreiIDE.selectModel",
        "title": "xpreiIDE: Select Model"
      },
      {
        "command": "xpreiIDE.selectEmbedModel",
        "title": "xpreiIDE: Select Embedding Model"
      },
      {
        "command": "xpreiIDE.setApiKey",
        "title": "xpreiIDE: Set Provider API Key"
      },
      {
        "command": "xpreiIDE.rebuildIndex",
        "title": "xpreiIDE: Rebuild Codebase Index"
      },
      {
        "command": "xpreiIDE.inlineEdit",
        "title": "xpreiIDE: Edit Selection (Inline)"
      },
      {
        "command": "xpreiIDE.inlineEdit.accept",
        "title": "xpreiIDE: Accept Inline Edit"
      },
      {
        "command": "xpreiIDE.inlineEdit.reject",
        "title": "xpreiIDE: Reject Inline Edit"
      },
      {
        "command": "xpreiIDE.revertAgentRun",
        "title": "xpreiIDE: Revert Last Agent Run"
      }
    ],
    "keybindings": [
      {
        "command": "xpreiIDE.inlineEdit",
        "key": "ctrl+k",
        "mac": "cmd+k",
        "when": "editorTextFocus"
      },
      {
        "command": "xpreiIDE.inlineEdit.accept",
        "key": "enter",
        "when": "editorTextFocus && xpreiIDE.inlineEditActive"
      },
      {
        "command": "xpreiIDE.inlineEdit.reject",
        "key": "escape",
        "when": "editorTextFocus && xpreiIDE.inlineEditActive"
      }
    ],
    "configuration": {
      "title": "xpreiIDE AI",
      "properties": {
        "xpreiIDE.providers": {
          "type": "array",
          "default": [
            {
              "id": "ollama-local",
              "kind": "ollama",
              "label": "Ollama (local)",
              "baseUrl": "http://localhost:11434"
            }
          ],
          "description": "Configured model providers. Each entry: { id, kind: 'ollama' | 'openai-compat', label, baseUrl, model? }. API keys are stored separately via 'xpreiIDE: Set Provider API Key'.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "kind": { "type": "string", "enum": ["ollama", "openai-compat"] },
              "label": { "type": "string" },
              "baseUrl": { "type": "string" },
              "model": { "type": "string" }
            },
            "required": ["id", "kind", "baseUrl"]
          }
        },
        "xpreiIDE.activeModel": {
          "type": "string",
          "default": "",
          "description": "Currently selected chat model, formatted 'providerId::modelName'. Set via 'xpreiIDE: Select Model'."
        },
        "xpreiIDE.embedModel": {
          "type": "string",
          "default": "",
          "description": "Embedding model for the codebase index, formatted 'providerId::modelName' (e.g. 'ollama-local::nomic-embed-text'). Set via 'xpreiIDE: Select Embedding Model'."
        },
        "xpreiIDE.agent.maxSteps": {
          "type": "number",
          "default": 20,
          "description": "Maximum tool-call steps the agent takes before stopping a run."
        },
        "xpreiIDE.agent.autoApprove": {
          "type": "boolean",
          "default": false,
          "description": "Skip the approval prompt for file writes and terminal commands during agent runs. Use with caution."
        }
      }
    }
  },
  "scripts": {
    "compile": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node",
    "watch": "npm run compile -- --sourcemap --watch",
    "vscode:prepublish": "npm run compile -- --minify",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/providers/ollama.test.ts src/providers/openai-compat.test.ts src/context/chunking.test.ts src/context/vectorstore.test.ts src/context/mentions.test.ts src/edit/prompt.test.ts src/agent/protocol.test.ts src/agent/tools.test.ts src/agent/checkpoint.test.ts src/agent/orchestrator.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.21.0",
    "tsx": "^4.16.0",
    "typescript": "^5.4.0"
  }
}
